server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Cliente HTTP del frontend -> backend (mismo origen, sin CORS).
    # BACKEND_UPSTREAM se sustituye al arrancar el contenedor:
    #   - red bridge de Docker: http://backend:8080
    #   - network_mode host:    http://127.0.0.1:8080
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # SPA con react-router: cualquier ruta desconocida vuelve a index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
}
